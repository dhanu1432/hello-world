### Step 3: Implement External Authentication Logic

For external authentication, create a custom `AuthenticationProvider` or a filter that extracts the `Authorization` header, makes a REST call to the external service, and authenticates the user based on the response.

Here’s an example using a custom `AuthenticationProvider`:

```java
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.security.authentication.AuthenticationProvider;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.AuthenticationException;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

@Component
public class ExternalAuthenticationProvider implements AuthenticationProvider {

    private final WebClient webClient;

    public ExternalAuthenticationProvider(WebClient.Builder webClientBuilder) {
        this.webClient = webClientBuilder.baseUrl("http://external-service/api/auth").build();
    }

    @Override
    public Authentication authenticate(Authentication authentication) throws AuthenticationException {
        String authHeader = (String) authentication.getCredentials(); // Authorization header

        // Make REST call to external service
        Mono<String> response = webClient.get()
                .header(HttpHeaders.AUTHORIZATION, authHeader)
                .retrieve()
                .onStatus(status -> status != HttpStatus.OK, clientResponse -> 
                        Mono.error(new AuthenticationException("External auth failed") {}))
                .bodyToMono(String.class);

        // Block for simplicity (in production, handle async properly)
        String result = response.block();

        // Assuming external service returns a username or token on success
        if (result != null && !result.isEmpty()) {
            // Create authenticated token (customize roles/authorities as needed)
            return new UsernamePasswordAuthenticationToken(
                    result, // Principal (e.g., username or user ID from external service)
                    authHeader,
                    List.of(new SimpleGrantedAuthority("ROLE_EXTERNAL_USER"))
            );
        }

        throw new AuthenticationException("External authentication failed") {};
    }

    @Override
    public boolean supports(Class<?> authentication) {
        return UsernamePasswordAuthenticationToken.class.isAssignableFrom(authentication);
    }
}
```

