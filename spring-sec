### Step 4: Configure Spring Security with Multiple `SecurityFilterChain`s

Use two `SecurityFilterChain` beans to separate the authentication logic for `/v1/` (Basic Auth) and `/diag/auth/v1` (External Auth). The order of the filter chains matters, so use `@Order` to ensure proper precedence.

```java
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.annotation.Order;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.config.http.SessionCreationPolicy;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.security.web.authentication.www.BasicAuthenticationFilter;

@Configuration
@EnableWebSecurity
public class SecurityConfig {

    private final ExternalAuthenticationProvider externalAuthenticationProvider;

    public SecurityConfig(ExternalAuthenticationProvider externalAuthenticationProvider) {
        this.externalAuthenticationProvider = externalAuthenticationProvider;
    }

    // SecurityFilterChain for Basic Auth (/v1/**)
    @Bean
    @Order(1)
    public SecurityFilterChain basicAuthFilterChain(HttpSecurity http) throws Exception {
        http
            .securityMatcher("/v1/**") // Apply to /v1/** endpoints
            .authorizeHttpRequests(auth -> auth
                .anyRequest().authenticated()
            )
            .httpBasic(withDefaults())
            .sessionManagement(session -> session
                .sessionCreationPolicy(SessionCreationPolicy.STATELESS)
            );

        return http.build();
    }

    // SecurityFilterChain for External Auth (/diag/auth/v1/**)
    @Bean
    @Order(2)
    public SecurityFilterChain externalAuthFilterChain(HttpSecurity http) throws Exception {
        http
            .securityMatcher("/diag/auth/v1/**") // Apply to /diag/auth/v1/** endpoints
            .authorizeHttpRequests(auth -> auth
                .anyRequest().authenticated()
            )
            .sessionManagement(session -> session
                .sessionCreationPolicy(SessionCreationPolicy.STATELESS)
            )
            .authenticationProvider(externalAuthenticationProvider)
            .addFilterBefore(new ExternalAuthFilter(), BasicAuthenticationFilter.class);

        return http.build();
    }
}
```

