#### 5. Updated OrchestratorAgent
The orchestrator now initializes agents with the knowledge service and switch.

```java
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class OrchestratorAgent implements Agent<String> {
    private final Map<String, IssueAgent> agents;
    private final LlmService llmService;
    private final ChatHistoryService chatHistoryService;
    private final KnowledgeService knowledgeService;
    private final String sessionId;
    private boolean active = true;
    private String currentAgentKey;
    private final boolean usePredefinedSteps; // Switch for steps mode

    public OrchestratorAgent(String sessionId, boolean usePredefinedSteps) {
        this.llmService = new LlmService();
        this.chatHistoryService = new ChatHistoryService();
        this.knowledgeService = new KnowledgeService();
        this.sessionId = sessionId;
        this.usePredefinedSteps = usePredefinedSteps;
        this.agents = new HashMap<>();
        agents.put("call", new CallAgent(llmService, chatHistoryService, knowledgeService, sessionId, usePredefinedSteps));
        agents.put("text", new TextAgent(llmService, chatHistoryService, knowledgeService, sessionId, usePredefinedSteps));
        agents.put("browse", new BrowseAgent(llmService, chatHistoryService, knowledgeService, sessionId, usePredefinedSteps));
        this.currentAgentKey = null;
    }

    @Override
    public String perceiveEnvironment() {
        communicate("What issue are you facing? (e.g., 'I can’t call', 'No texting', 'Can’t browse', or 'quit')");
        Scanner scanner = new Scanner(System.in);
        return scanner.nextLine().toLowerCase();
    }

    @Override
    public Object processInput(String input) {
        chatHistoryService.saveChatHistory(sessionId, "User: " + input);
        if (input.contains("quit")) return "exit";

        List<String> chatHistory = chatHistoryService.getChatHistory(sessionId);
        String prompt = "Classify this user input into one or more issues (call, text, browse): '" + input + "'";
        String classification = llmService.generateResponse(prompt, chatHistory);
        chatHistoryService.saveChatHistory(sessionId, "Agent: Classified as " + classification);
        return classification.split(",");
    }

    @Override
    public Object decide(Object processedData) {
        String[] issues = (String[]) processedData;
        StringBuilder response = new StringBuilder();

        for (String issue : issues) {
            issue = issue.trim();
            if (issue.equals("exit")) {
                active = false;
                return "Goodbye";
            }
            if (agents.containsKey(issue)) {
                if (currentAgentKey != null && !currentAgentKey.equals(issue)) {
                    response.append("Switching to handle '").append(issue).append("' issue.\n");
                }
                currentAgentKey = issue;
                IssueAgent agent = agents.get(issue);
                Object agentDecision = agent.decide(agent.processInput(input));
                agent.act(agentDecision);
                response.append(agentDecision).append("\n");
            } else {
                response.append("I don’t recognize '").append(issue).append("'. Try 'call', 'text', or 'browse'.\n");
            }
        }
        return response.toString();
    }

    @Override
    public boolean act(Object decision) {
        communicate((String) decision);
        return true;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[Orchestrator] " + message);
    }

    @Override
    public boolean handleError(Exception error) {
        communicate("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive() {
        return active;
    }

    public static void main(String[] args) {
        String sessionId = "session_" + System.currentTimeMillis();
        // Toggle this to switch between predefined steps and knowledge docs
        boolean usePredefinedSteps = false; // Set to true for manual steps
        OrchestratorAgent orchestrator = new OrchestratorAgent(sessionId, usePredefinedSteps);
        while (orchestrator.isActive()) {
            try {
                String input = orchestrator.perceiveEnvironment();
                Object processed = orchestrator.processInput(input);
                Object decision = orchestrator.decide(processed);
                orchestrator.act(decision);
            } catch (Exception e) {
                orchestrator.handleError(e);
            }
        }
    }
}
```

