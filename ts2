#### 2. Updated CallAgent with Knowledge Context
The `CallAgent` now supports both predefined steps and dynamic knowledge retrieval.

```java
import java.util.ArrayList;
import java.util.List;

class CallAgent extends IssueAgent {
    private final List<String> predefinedSteps; // Manual steps
    private final KnowledgeService knowledgeService;
    private final boolean usePredefinedSteps; // Switch
    private int currentStepIndex; // For predefined steps mode

    public CallAgent(LlmService llmService, ChatHistoryService chatHistoryService, KnowledgeService knowledgeService, 
                     String sessionId, boolean usePredefinedSteps) {
        super(llmService, chatHistoryService, sessionId);
        this.knowledgeService = knowledgeService;
        this.usePredefinedSteps = usePredefinedSteps;
        this.predefinedSteps = new ArrayList<>();
        if (usePredefinedSteps) {
            this.predefinedSteps.add("Ask if the user has checked their signal strength.");
            this.predefinedSteps.add("Suggest restarting the phone.");
            this.predefinedSteps.add("Suggest checking if airplane mode is on.");
            this.predefinedSteps.add("Suggest verifying the SIM card is inserted correctly.");
        }
        this.currentStepIndex = 0;
    }

    @Override
    public Object processInput(String input) {
        saveToHistory("User: " + input);
        return input;
    }

    @Override
    public Object decide(Object processedData) {
        String input = (String) processedData;
        List<String> chatHistory = chatHistoryService.getChatHistory(sessionId);
        String prompt;

        if (usePredefinedSteps) {
            // Predefined steps mode
            if (currentStepIndex >= predefinedSteps.size()) {
                prompt = "User says: '" + input + "'. All predefined steps exhausted. Suggest contacting support.";
            } else {
                String step = predefinedSteps.get(currentStepIndex);
                prompt = step + "\nUser response: '" + input + "'\nProvide a natural response based on this step.";
                currentStepIndex++;
            }
        } else {
            // Knowledge document mode
            String knowledge = knowledgeService.getKnowledge("call");
            prompt = "User says: '" + input + "'\n" +
                     "Use this knowledge to provide troubleshooting steps:\n" + knowledge + "\n" +
                     "Based on the chat history and knowledge, suggest the next step or ask a question.";
        }

        String response = llmService.generateResponse(prompt, chatHistory);
        saveToHistory("Agent: " + response);
        return response;
    }

    @Override
    public boolean act(Object decision) {
        String response = (String) decision;
        communicate(response);
        if (response.contains("restart the phone")) {
            communicate("Action: Suggesting phone restart.");
        }
        return true;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[CallAgent] " + message);
    }

    public int getCurrentStepIndex() {
        return currentStepIndex;
    }

    public void resetSteps() {
        currentStepIndex = 0;
    }
}
```

