### 3. Updated `FlowConfig`

Define flows without duplication:

```java
package com.example.config;

import com.example.flow.BaseFlow;
import com.example.flow.Flow;
import com.example.service.DynamicPromptService;
import com.example.service.KnowledgeStore;
import com.example.service.LlmService;
import com.example.service.MongoKnowledgeStore;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.ai.embedding.EmbeddingModel;
import org.springframework.ai.openai.OpenAiChatModel;
import org.springframework.ai.openai.OpenAiEmbeddingModel;
import org.springframework.ai.openai.api.OpenAiApi;
import org.springframework.ai.vectorstore.VectorStore;
import org.springframework.ai.vectorstore.mongodb.MongoDBAtlasVectorStore;

@Configuration
public class FlowConfig {

    // Minimal flow using BaseFlow directly
    @Bean(name = "simpleFlow")
    public Flow simpleFlow() {
        return new BaseFlow("simple_flow", "basic");
    }

    // Custom promptText and VectorStore
    @Bean(name = "notAbleToCallFlow")
    public Flow notAbleToCallFlow(@Qualifier("teamAVectorStore") VectorStore teamAVectorStore) {
        return new BaseFlow(
                "not_able_to_call",
                "Provide troubleshooting steps for the following issue:",
                teamAVectorStore,
                null,
                "detailed"
        );
    }

    // Custom flow with overridden execute
    @Bean(name = "noInternetFlow")
    public Flow noInternetFlow(@Qualifier("teamBKnowledgeStore") KnowledgeStore teamBKnowledgeStore) {
        return new BaseFlow("no_internet", "Diagnose and suggest fixes for:", null, teamBKnowledgeStore, "basic") {
            @Override
            public String execute(String userInput, String sessionId, DynamicPromptService promptService, LlmService llmService) {
                String apiResult = simulateNetworkCheck(userInput);
                String dynamicPrompt = promptService.buildPrompt(userInput, null, getTemplateName(), 
                                                               getVectorStore(), getKnowledgeStore(), sessionId);
                String finalPrompt = getPromptText() + "\n" + dynamicPrompt + "\nAPI Result: " + apiResult;
                return llmService.executePrompt(finalPrompt, sessionId);
            }

            private String simulateNetworkCheck(String userInput) {
                return "Network status: Router offline";
            }
        };
    }

    @Bean
    public EmbeddingModel embeddingModel() {
        return new OpenAiEmbeddingModel(new OpenAiApi("your-openai-api-key"));
    }

    @Bean
    public ChatClient chatClient() {
        OpenAiApi openAiApi = new OpenAiApi("your-openai-api-key");
        OpenAiChatModel chatModel = new OpenAiChatModel(openAiApi);
        return ChatClient.builder(chatModel).build();
    }

    @Bean(name = "defaultVectorStore")
    public VectorStore defaultVectorStore(MongoTemplate mongoTemplate, EmbeddingModel embeddingModel) {
        return MongoDBAtlasVectorStore.builder()
                .withMongoTemplate(mongoTemplate)
                .withEmbeddingModel(embeddingModel)
                .withCollectionName("default_vector_collection")
                .build();
    }

    @Bean(name = "teamAVectorStore")
    public VectorStore teamAVectorStore(MongoTemplate mongoTemplate, EmbeddingModel embeddingModel) {
        return MongoDBAtlasVectorStore.builder()
                .withMongoTemplate(mongoTemplate)
                .withEmbeddingModel(embeddingModel)
                .withCollectionName("vector_collection_team_a")
                .build();
    }

    @Bean(name = "defaultKnowledgeStore")
    public KnowledgeStore defaultKnowledgeStore(MongoTemplate mongoTemplate) {
        return new MongoKnowledgeStore(mongoTemplate, "default_knowledge_collection");
    }

    @Bean(name = "teamBKnowledgeStore")
    public KnowledgeStore teamBKnowledgeStore(MongoTemplate mongoTemplate) {
        return new MongoKnowledgeStore(mongoTemplate, "knowledge_collection_team_b");
    }
}
```

**Changes**:
- `simpleFlow`: Uses `BaseFlow` directly with no overrides.
- `notAbleToCallFlow`: Uses full constructor with custom `promptText` and `vectorStore`, no overrides needed.
- `noInternetFlow`: Extends `BaseFlow` anonymously, overriding only `execute` for custom logic, no getter duplication.

