### 4. Static Context Retrieval

#### `StaticContextRetriever`
Unchanged:
```java
package com.example.service;

import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

@Service
public class StaticContextRetriever implements ContextRetriever {

    private final MongoTemplate mongoTemplate;

    public StaticContextRetriever(MongoTemplate mongoTemplate) {
        this.mongoTemplate = mongoTemplate;
    }

    @Override
    public String retrieveContext(String flowIdentifier) {
        Query query = new Query(Criteria.where("flowIdentifier").is(flowIdentifier));
        StaticContextDoc doc = mongoTemplate.findOne(query, StaticContextDoc.class, "static_context");
        return doc != null ? doc.getContent() : "No static context found for flowIdentifier: " + flowIdentifier;
    }

    public static class StaticContextDoc {
        private String flowIdentifier;
        private String content;

        public String getFlowIdentifier() {
            return flowIdentifier;
        }

        public void setFlowIdentifier(String flowIdentifier) {
            this.flowIdentifier = flowIdentifier;
        }

        public String getContent() {
            return content;
        }

        public void setContent(String content) {
            this.content = content;
        }
    }
}
```

