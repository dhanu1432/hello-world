   import org.springframework.web.bind.annotation.GetMapping;
   import org.springframework.web.bind.annotation.RequestParam;
   import org.springframework.web.bind.annotation.RestController;

   @RestController
   public class PromptController {

       private final DynamicPromptService promptService;

       public PromptController(DynamicPromptService promptService) {
           this.promptService = promptService;
       }

       @GetMapping("/generate-prompt")
       public String generatePrompt(@RequestParam String query) {
           String prompt = promptService.buildPrompt(query);
           // Optionally send prompt to LLM here
           return prompt;
       }
   }
