### Full Working Example
Here’s the complete setup with your controller:

```java
import com.azure.ai.openai.OpenAIClient;
import com.azure.ai.openai.OpenAIClientBuilder;
import com.azure.ai.openai.models.ChatCompletions;
import com.azure.ai.openai.models.ChatCompletionsOptions;
import com.azure.ai.openai.models.ChatRequestMessage;
import com.azure.ai.openai.models.ChatRole;
import com.azure.core.credential.TokenCredential;
import com.azure.core.http.HttpPipeline;
import com.azure.core.http.HttpPipelineBuilder;
import com.azure.core.http.policy.BearerTokenAuthenticationPolicy;
import com.azure.identity.ClientSecretCredentialBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.Arrays;
import java.util.List;

@Configuration
public class AzureOpenAIConfig {

    @Bean
    public TokenCredential tokenCredential() {
        return new ClientSecretCredentialBuilder()
            .clientId("YOUR_CLIENT_ID")
            .clientSecret("YOUR_CLIENT_SECRET")
            .tenantId("YOUR_TENANT_ID")
            .build();
    }

    @Bean
    public OpenAIClient openAIClient(TokenCredential tokenCredential) {
        String scope = "https://cognitiveservices.azure.com/.default"; // Adjust if custom

        HttpPipeline pipeline = new HttpPipelineBuilder()
            .policies(new BearerTokenAuthenticationPolicy(tokenCredential, scope))
            .build();

        return new OpenAIClientBuilder()
            .endpoint("https://your-resource-name.openai.azure.com/")
            .pipeline(pipeline)
            .buildClient();
    }
}

@RestController
public class ChatController {
    private final OpenAIClient openAIClient;

    public ChatController(OpenAIClient openAIClient) {
        this.openAIClient = openAIClient;
    }

    @GetMapping("/chat")
    public String chat(@RequestParam String userMessage) {
        List<ChatRequestMessage> messages = Arrays.asList(
            new ChatRequestMessage(ChatRole.SYSTEM, "You are a helpful assistant."),
            new ChatRequestMessage(ChatRole.USER, userMessage)
        );
        ChatCompletionsOptions options = new ChatCompletionsOptions(messages)
            .setMaxTokens(100)
            .setTemperature(0.7);

        try {
            ChatCompletions completions = openAIClient.getChatCompletions("your-deployment-name", options);
            return completions.getChoices().get(0).getMessage().getContent();
        } catch (Exception e) {
            e.printStackTrace();
            return "Error: " + e.getMessage();
        }
    }
}
```

