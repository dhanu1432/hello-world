### 2. Updated `ConversationHistoryService`

Manage session-based message lists:

```java
package com.example.service;

import com.example.model.ConversationHistory;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.data.mongodb.core.query.Update;
import org.springframework.stereotype.Service;

@Service
public class ConversationHistoryService {

    private final MongoTemplate mongoTemplate;

    public ConversationHistoryService(MongoTemplate mongoTemplate) {
        this.mongoTemplate = mongoTemplate;
    }

    public void saveOrUpdateHistory(String sessionId, String userInput, String prompt, String responseContent) {
        if (sessionId == null || sessionId.trim().isEmpty()) {
            throw new IllegalArgumentException("sessionId cannot be null or empty");
        }

        Query query = new Query(Criteria.where("sessionId").is(sessionId));
        ConversationHistory history = mongoTemplate.findOne(query, ConversationHistory.class);

        if (history == null) {
            history = new ConversationHistory(sessionId);
        }

        // Add user message (input as part of prompt)
        history.addMessage("user", prompt);
        // Add assistant message (response)
        history.addMessage("assistant", responseContent);

        mongoTemplate.save(history);
    }

    public ConversationHistory getHistoryBySessionId(String sessionId) {
        if (sessionId == null || sessionId.trim().isEmpty()) {
            return null; // Or throw exception if preferred
        }
        Query query = new Query(Criteria.where("sessionId").is(sessionId));
        return mongoTemplate.findOne(query, ConversationHistory.class);
    }
}
```

**Changes**:
- Updated to handle a single `ConversationHistory` document per `sessionId`, appending messages to its list.
- Stores the prompt as a `user` message and the LLM response as an `assistant` message.

