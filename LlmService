### 5. Updated `LlmService`

Handles message list and LLM calls:

```java
package com.example.service;

import com.example.model.ConversationHistory;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.ai.chat.model.ChatResponse;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class LlmService {

    private final ChatClient chatClient;
    private final ConversationHistoryService historyService;

    public LlmService(ChatClient chatClient, ConversationHistoryService historyService) {
        this.chatClient = chatClient;
        this.historyService = historyService;
    }

    @Cacheable(value = "llmResponses", key = "#sessionId + #prompt")
    public String executePrompt(String prompt, String sessionId, float temperature, int maxTokens) {
        if (prompt == null || prompt.trim().isEmpty()) {
            throw new IllegalArgumentException("Prompt cannot be null or empty");
        }
        if (sessionId == null || sessionId.trim().isEmpty()) {
            throw new IllegalArgumentException("sessionId cannot be null or empty");
        }

        // Get existing conversation history
        ConversationHistory history = historyService.getHistoryBySessionId(sessionId);
        List<ConversationHistory.Message> messages = history != null ? history.getMessages() : List.of();

        // Build ChatClient request with message history
        ChatClient.RequestSpec request = chatClient.prompt();
        for (ConversationHistory.Message msg : messages) {
            if ("user".equals(msg.getRole())) {
                request.user(msg.getContent());
            } else if ("assistant".equals(msg.getRole())) {
                request.assistant(msg.getContent());
            }
        }
        request.user(prompt); // Add current user input

        // Execute LLM call
        String responseContent;
        try {
            ChatResponse response = request.options(options -> options
                    .temperature(temperature)
                    .maxTokens(maxTokens))
                    .call()
                    .chatResponse();
            responseContent = response.getResult().getOutput().getContent();
        } catch (Exception e) {
            responseContent = "Error calling LLM: " + e.getMessage();
        }

        // Save updated history
        historyService.saveOrUpdateHistory(sessionId, prompt, prompt, responseContent);

        return responseContent;
    }

    public String executePrompt(String prompt, String sessionId) {
        return executePrompt(prompt, sessionId, 0.7f, 256);
    }
}
```

**Changes**:
- Uses `ChatClient`’s message history support by adding past messages via `user()` and `assistant()`.
- Saves the full message list after appending the new user prompt and assistant response.
- Extracts `content` from the `ChatResponse` object.

