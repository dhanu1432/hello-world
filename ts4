        if (input != null && (input.toLowerCase().contains("fixed") || input.toLowerCase().contains("working now"))) {
            learn(sessionId, "browse", null, response.getText());
            return response.getText();
        }

        return response.getText();
    }

    @Override
    public String act(String sessionId, Object decision) {
        String response = (String) decision;
        communicate(response);
        return response;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[BrowseAgent] " + message);
    }
