package com.example.dice;

import com.google.gson.Gson;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Map;

@Component
@RequiredArgsConstructor
public class OrchestratorAgent implements Agent<DiceSessionContext> {
    private final LlmService llmService;
    private final ChatHistoryService chatHistoryService;
    private final KnowledgeService knowledgeService;
    private final LearningService learningService;
    private final SessionSummaryService sessionSummaryService;
    private final AgentFactory agentFactory;

    @Override
    public DiceSessionContext perceiveEnvironment() {
        return null;
    }

    @Override
    public Object processInput(DiceSessionContext context) {
        String input = context.getUserInput() != null ? context.getUserInput() : context.getFlowIdentifier();
        chatHistoryService.saveChatHistory(context.getDiceSessionId(), "User: " + input);
        if (input.contains("quit")) return "exit";

        ChatHistoryService.OrchestratorState state = chatHistoryService.getOrchestratorState(context.getDiceSessionId());
        if (state == null) {
            state = new ChatHistoryService.OrchestratorState(
                context.getDiceSessionId(), context.getOlSessionId(), context.getBan(), null, true
            );
        } else {
            state.setOlSessionId(context.getOlSessionId());
            state.setBan(context.getBan());
        }
        chatHistoryService.saveOrchestratorState(state);

        List<String> chatHistory = chatHistoryService.getChatHistory(context.getDiceSessionId());
        String prompt = "Classify this user input into one or more issues (call, text, browse): '" + input + "'";
        LlmService.LlmResponse response = llmService.generateResponse(prompt, chatHistory);
        chatHistoryService.saveChatHistory(context.getDiceSessionId(), "Agent: Classified as " + response.getText());
        return response.getText().split(",");
    }

    @Override
    public Object decide(String sessionId, String input) {
        ChatHistoryService.OrchestratorState state = chatHistoryService.getOrchestratorState(sessionId);
        if (state == null || !state.isActive()) {
            return "Session not initialized or completed. Start a new session with /engage.";
        }

        Object processed = processInput(new DiceSessionContext(state.getOlSessionId(), sessionId, state.getCurrentAgentKey(), input, state.getBan()));
        String[] issues = (String[]) processed;
        StringBuilder response = new StringBuilder();

        for (String issue : issues) {
            issue = issue.trim();
            if (issue.equals("exit")) {
                state.setActive(false);
                chatHistoryService.saveOrchestratorState(state);
                generateAndSaveSummary(sessionId);
                return "Goodbye";
            }
            if (agentFactory.getAgent(issue) != null) {
                if (state.getCurrentAgentKey() != null && !state.getCurrentAgentKey().equals(issue)) {
                    response.append("Switching to handle '").append(issue).append("' issue.\n");
                }
                state.setCurrentAgentKey(issue);
                chatHistoryService.saveOrchestratorState(state);
                IssueAgent agent = agentFactory.getAgent(issue);
                Object agentDecision = agent.decide(sessionId, input);
                String agentResponse = agent.act(sessionId, agentDecision);
                response.append(agentResponse).append("\n");
            } else {
                response.append("I don’t recognize '").append(issue).append("'. Try 'call', 'text', or 'browse'.\n");
            }
        }
        return response.toString();
    }

    @Override
    public String act(String sessionId, Object decision) {
        String message = (String) decision;
        communicate(message);
        return message;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[Orchestrator] " + message);
    }

    @Override
    public boolean handleError(Exception error) {
        communicate("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive(String sessionId) {
        ChatHistoryService.OrchestratorState state = chatHistoryService.getOrchestratorState(sessionId);
        return state != null && state.isActive();
    }

    @Override
    public void learn(String sessionId, String issue, String subFlow, String solution) {
    }

    public String startSession(DiceSessionContext context) {
        ChatHistoryService.OrchestratorState state = new ChatHistoryService.OrchestratorState(
            context.getDiceSessionId(), context.getOlSessionId(), context.getBan(), context.getFlowIdentifier(), true
        );
        chatHistoryService.saveOrchestratorState(state);

        IssueAgent agent = agentFactory.getAgent(context.getFlowIdentifier());
        if (agent == null) {
            return "Invalid flowIdentifier: " + context.getFlowIdentifier() + ". Use 'call', 'text', or 'browse'.";
        }
        Object decision = agent.decide(context.getDiceSessionId(), "");
        return agent.act(context.getDiceSessionId(), decision);
    }

    public String continueSession(DiceSessionContext context) {
        return (String) decide(context.getDiceSessionId(), context.getUserInput());
    }

    private void generateAndSaveSummary(String sessionId) {
        ChatHistoryService.OrchestratorState state = chatHistoryService.getOrchestratorState(sessionId);
        List<String> chatHistory = chatHistoryService.getChatHistory(sessionId);
        String summaryJson = llmService.generateSessionSummary(chatHistory);
        Gson gson = new Gson();
        Map<String, String> summaryMap = gson.fromJson(summaryJson, Map.class);
        String summary = summaryMap.get("summary");
        String sentiment = summaryMap.get("sentiment");
        sessionSummaryService.saveSessionSummary(state.getOlSessionId(), sessionId, state.getBan(), summary, sentiment);
    }

    public String getDiceSessionId() {
        return diceSessionId;
    }
}
