package com.example.dice;

import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

@Component
@RequiredArgsConstructor
public abstract class IssueAgent implements Agent<DiceSessionContext> {
    protected final LlmService llmService;
    protected final ChatHistoryService chatHistoryService;
    protected final LearningService learningService;
    protected final Environment environment;

    @Value("${agent.default.mode:LLM_AS_A_DRIVER}")
    protected AgentMode defaultMode;

    protected abstract AgentMode getAgentMode();

    protected abstract String getAgentKey();

    protected AgentMode getEffectiveMode(String sessionId, String subFlow) {
        ChatHistoryService.OrchestratorState orchestratorState = chatHistoryService.getOrchestratorState(sessionId);
        String flowIdentifier = orchestratorState != null ? orchestratorState.getCurrentAgentKey() : getAgentKey();

        AgentMode agentMode = getAgentMode();
        if (agentMode != null && !agentMode.name().equalsIgnoreCase("default")) {
            return agentMode;
        }

        String subFlowModeProperty = subFlow != null ? "agent." + flowIdentifier + "." + subFlow + ".mode" : "agent." + flowIdentifier + ".mode";
        String modeValue = environment.getProperty(subFlowModeProperty, defaultMode.name());
        return AgentMode.valueOf(modeValue.toUpperCase());
    }

    @Override
    public DiceSessionContext perceiveEnvironment() {
        return null;
    }

    @Override
    public Object processInput(DiceSessionContext input) {
        return input.getUserInput();
    }

    @Override
    public boolean handleError(Exception error) {
        communicate("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive(String sessionId) {
        ChatHistoryService.AgentState state = chatHistoryService.getAgentState(sessionId, getAgentKey());
        return state != null && !state.isCompleted();
    }

    @Override
    public void learn(String sessionId, String issue, String subFlow, String solution) {
        learningService.recordSuccess(issue, subFlow, solution);
        ChatHistoryService.AgentState state = chatHistoryService.getAgentState(sessionId, issue);
        if (state == null) {
            state = new ChatHistoryService.AgentState(sessionId, issue, subFlow, 0, true);
        } else {
            state.setCompleted(true);
        }
        chatHistoryService.saveAgentState(state);
    }

    protected void saveToHistory(String sessionId, String message) {
        chatHistoryService.saveChatHistory(sessionId, message);
    }

    protected String getBan(String sessionId) {
        ChatHistoryService.OrchestratorState state = chatHistoryService.getOrchestratorState(sessionId);
        return state != null ? state.getBan() : null;
    }
}
