import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
public class ChatbotController {
    @Autowired
    private SemanticCacheService cacheService;
    @Autowired
    private VectorSearchService vectorSearchService;

    @GetMapping("/query")
    public List<Document> processQuery(@RequestParam String query) {
        float[] embedding = cacheService.getOrComputeEmbedding(query);
        return vectorSearchService.searchDocuments(embedding);
    }
}
