import com.theokanning.openai.embedding.EmbeddingRequest;
import com.theokanning.openai.service.OpenAiService;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.util.Collections;

@Service
public class EmbeddingService {
    private final OpenAiService openAiService;

    public EmbeddingService(@Value("${openai.api-key}") String apiKey) {
        this.openAiService = new OpenAiService(apiKey);
    }

    public float[] getEmbedding(String text) {
        EmbeddingRequest request = EmbeddingRequest.builder()
            .model("text-embedding-3-small")
            .input(Collections.singletonList(text))
            .build();
        return openAiService.createEmbeddings(request)
            .getData().get(0).getEmbedding().stream()
            .map(Double::floatValue).toArray(Float[]::new);
    }
}
```

#### 3. Semantic Cache Service (Using Atlas Vector Search)
```java
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.aggregation.Aggregation;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

import java.time.Instant;
import java.util.List;

@Service
public class SemanticCacheService {
    @Autowired
    private MongoTemplate mongoTemplate;
    @Autowired
    private EmbeddingService embeddingService;

    private final float similarityThreshold = 0.1f; // Adjust based on testing (L2 distance)

    public float[] getOrComputeEmbedding(String query) {
        // Step 1: Check for exact match in query_embeddings
        Query exactQuery = new Query(Criteria.where("query").is(query));
        Document cached = mongoTemplate.findOne(exactQuery, Document.class, "query_embeddings");
        if (cached != null) {
            return cached.get("embedding", float[].class); // Assuming embedding stored as float array
        }

        // Step 2: Compute embedding (~2 seconds)
        float[] queryEmbedding = embeddingService.getEmbedding(query);

        // Step 3: Check for semantically similar queries using Atlas Vector Search
        Document vectorSearchStage = new Document("$vectorSearch",
            new Document("index", "query_vector_index") // Ensure this index exists
                .append("queryVector", queryEmbedding)
                .append("path", "embedding")
                .append("numCandidates", 50)
                .append("limit", 1));
        
        Aggregation aggregation = Aggregation.newAggregation(
            Aggregation.stage(vectorSearchStage),
            Aggregation.project("query", "embedding").and("score", "$vectorSearchScore")
        );

        List<Document> similarResults = mongoTemplate.aggregate(aggregation, "query_embeddings", Document.class)
            .getMappedResults();

        if (!similarResults.isEmpty()) {
            Document similar = similarResults.get(0);
            float score = similar.getFloat("score"); // 0 to 1, higher is more similar
            // Convert score to L2-like distance (simplified approximation)
            float distance = 1 - score; // Adjust based on Atlas’s scoring
            if (distance < similarityThreshold) {
                return similar.get("embedding", float[].class);
            }
        }

        // Step 4: Cache the new embedding
        Document newEntry = new Document("query", query)
            .append("embedding", queryEmbedding)
            .append("timestamp", Instant.now().toString());
        mongoTemplate.insert(newEntry, "query_embeddings");

        return queryEmbedding;
    }
}
```

#### 4. Vector Search Service (Unchanged)
```java
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.aggregation.Aggregation;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class VectorSearchService {
    @Autowired
    private MongoTemplate mongoTemplate;

    public List<Document> searchDocuments(float[] queryEmbedding) {
        Document vectorSearchStage = new Document("$vectorSearch",
            new Document("index", "vector_index")
                .append("queryVector", queryEmbedding)
                .append("path", "embedding")
                .append("numCandidates", 100)
                .append("limit", 5));

        Aggregation aggregation = Aggregation.newAggregation(
            Aggregation.stage(vectorSearchStage)
        );

        return mongoTemplate.aggregate(aggregation, "knowledge_articles", Document.class)
            .getMappedResults();
    }
}
```

