### Updated Code (No TTL)
Here’s the `SemanticCacheService` without the TTL index:

```java
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.aggregation.Aggregation;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class SemanticCacheService {
    @Autowired
    private MongoTemplate mongoTemplate;
    @Autowired
    private EmbeddingService embeddingService;

    private final float similarityThreshold = 0.1f; // Adjust based on testing

    public float[] getOrComputeEmbedding(String query) {
        // Step 1: Check for exact match
        Query exactQuery = new Query(Criteria.where("query").is(query));
        Document cached = mongoTemplate.findOne(exactQuery, Document.class, "query_embeddings");
        if (cached != null) {
            return cached.get("embedding", float[].class);
        }

        // Step 2: Compute embedding (~2 seconds)
        float[] queryEmbedding = embeddingService.getEmbedding(query);

        // Step 3: Check for semantically similar queries
        Document vectorSearchStage = new Document("$vectorSearch",
            new Document("index", "query_vector_index")
                .append("queryVector", queryEmbedding)
                .append("path", "embedding")
                .append("numCandidates", 50)
                .append("limit", 1));
        
        Aggregation aggregation = Aggregation.newAggregation(
            Aggregation.stage(vectorSearchStage),
            Aggregation.project("query", "embedding").and("score", "$vectorSearchScore")
        );

        List<Document> similarResults = mongoTemplate.aggregate(aggregation, "query_embeddings", Document.class)
            .getMappedResults();

        if (!similarResults.isEmpty()) {
            Document similar = similarResults.get(0);
            float score = similar.getFloat("score");
            float distance = 1 - score; // Approximate L2 distance
            if (distance < similarityThreshold) {
                return similar.get("embedding", float[].class);
            }
        }

        // Step 4: Cache the new embedding (no timestamp/TTL)
        Document newEntry = new Document("query", query)
            .append("embedding", queryEmbedding);
        mongoTemplate.insert(newEntry, "query_embeddings");

        return queryEmbedding;
    }
}
```

