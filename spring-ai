import java.util.Optional;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class LlmService {
    private final ChatClient chatClient;
    private final MongoTemplate mongoTemplate;
    private final Gson gson = new Gson();

    @Getter
    @Setter
    @NoArgsConstructor
    public static class LlmResponse {
        private String text;
        private String tool;
        private String toolInput;

        public LlmResponse(String text, String tool, String toolInput) {
            this.text = text;
            this.tool = tool;
            this.toolInput = toolInput;
        }
    }

    @Getter
    @Setter
    @NoArgsConstructor
    @AllArgsConstructor
    public static class RagVectorData {
        private String issue;
        private String subFlow;
        private String solution;
        private float[] vector; // Placeholder for vectorized data
    }

    public LlmResponse generateResponse(String prompt, List<String> chatHistory, Optional<String> ragContext) {
        String fullPrompt = chatHistory.stream().collect(Collectors.joining("\n", "Chat History:\n", "\n")) +
                           ragContext.map(ctx -> "RAG Context:\n" + ctx + "\n").orElse("") +
                           "Current Prompt:\n" + prompt + "\n" +
                           "Respond with JSON: {\"text\": \"response\", \"tool\": \"tool_name\", \"toolInput\": \"input\"} " +
                           "or leave tool/toolInput null if no tool is needed.";
        String response = chatClient.call(fullPrompt);
        return gson.fromJson(response, LlmResponse.class);
    }

    public String generateSessionSummary(List<String> chatHistory) {
        String prompt = chatHistory.stream().collect(Collectors.joining("\n", "Chat History:\n", "\n")) +
                        "Generate a summary of this session including:\n" +
                        "- Steps performed and their effectiveness (effective/ineffective).\n" +
                        "- Customer sentiment at the end (positive, negative, neutral).\n" +
                        "Return in JSON: {\"summary\": \"steps and effectiveness\", \"sentiment\": \"sentiment\"}";
        return chatClient.call(prompt);
    }

    public List<RagVectorData> queryVectorData(String input, String subFlow) {
        Query query = Query.query(Criteria.where("subFlow").is(subFlow)).limit(5); // Top 5 results
        return mongoTemplate.find(query, RagVectorData.class, "rag_vectors");
    }
}
