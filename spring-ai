package com.example.dice;

import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import javax.annotation.PostConstruct;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
public class KnowledgeService {
    private final Map<String, List<String>> knowledgeSteps = new HashMap<>();

    @PostConstruct
    public void init() {
        knowledgeSteps.put("voice", List.of(
            "Ask if the user has checked their signal strength.",
            "Suggest restarting the phone.",
            "Suggest checking if airplane mode is on.",
            "Suggest verifying the SIM card is inserted correctly."
        ));
    }

    public List<String> getSteps(String flowIdentifier) {
