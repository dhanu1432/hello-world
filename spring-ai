package com.example.dice;

import lombok.Getter;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Optional;

@Component
@RequiredArgsConstructor
public class VoiceAgent extends IssueAgent {
    private final KnowledgeService knowledgeService;
    private final SessionSummaryService sessionSummaryService;
    private final VoiceAgentPrompts voiceAgentPrompts;

    @Value("${rag.enabled:false}")
    private boolean ragEnabled;

    public VoiceAgent(LlmService llmService, ChatHistoryService chatHistoryService, LearningService learningService,
                      Environment environment, KnowledgeService knowledgeService, SessionSummaryService sessionSummaryService,
                      VoiceAgentPrompts voiceAgentPrompts) {
        super(llmService, chatHistoryService, learningService, environment);
        this.knowledgeService = knowledgeService;
        this.sessionSummaryService = sessionSummaryService;
        this.voiceAgentPrompts = voiceAgentPrompts;
    }

    @Override
    protected String getAgentKey() {
        return "voice";
    }

    @Override
    public Object decide(String sessionId, String input) {
        List<String> chatHistory = chatHistoryService.getChatHistory(sessionId);
        ChatHistoryService.AgentState state = chatHistoryService.getAgentState(sessionId, "voice");
        String subFlow = Optional.ofNullable(state).map(ChatHistoryService.AgentState::getSubFlow).orElse(null);

        if (subFlow == null) {
            return decideSubFlow(sessionId, input, chatHistory);
        }

        return decideNextStep(sessionId, input, subFlow, chatHistory);
    }

    private Object decideSubFlow(String sessionId, String input, List<String> chatHistory) {
        String prompt = "User says: '" + input + "'\n" +
                        "Classify into a sub-flow: cant_make_calls, cant_receive_calls, dropped_calls. " +
                        "If input is empty, ask the user to specify.";
        LlmService.LlmResponse subFlowResponse = llmService.generateResponse(prompt, chatHistory, Optional.empty());
        if (subFlowResponse.getText().contains("specify")) {
            return new Decision(subFlowResponse.getText(), null);
        }
        String subFlow = subFlowResponse.getText().trim();
        if (!voiceAgentPrompts.isSubFlowAvailable(subFlow)) {
            return new Decision("Unsupported sub-flow: " + subFlow + ". Available sub-flows: cant_make_calls, cant_receive_calls, dropped_calls.", null);
        }
        saveToHistory(sessionId, "Agent: Identified sub-flow: " + subFlow);
        chatHistoryService.saveAgentState(new ChatHistoryService.AgentState(sessionId, "voice", subFlow, 0, false));
        return decideNextStep(sessionId, input, subFlow, chatHistory);
    }

    private Object decideNextStep(String sessionId, String input, String subFlow, List<String> chatHistory) {
        String flowPrompt = voiceAgentPrompts.getPrompt(subFlow);
        Optional<String> ragContext = ragEnabled ? retrieveRagContext(input, subFlow) : Optional.empty();
        String prompt = flowPrompt + "\n" +
                        "User says: '" + input + "'\n" +
                        "Sub-flow: " + subFlow + "\n" +
                        (ragContext.map(ctx -> "RAG Context:\n" + ctx + "\n").orElse("")) +
                        "Fetch context from the web about mobile voice troubleshooting and decide the next step or response.\n" +
                        "Use available tools (network_status, outage_check) if needed.";
        LlmService.LlmResponse response = llmService.generateResponse(prompt, chatHistory, ragContext);
        saveToHistory(sessionId, "Agent: " + response.getText());

        if (Optional.ofNullable(input).filter(i -> i.toLowerCase().contains("fixed") || i.toLowerCase().contains("working now")).isPresent()) {
            learn(sessionId, "voice", subFlow, response.getText());
            return new Decision("Great, glad it’s resolved!", null);
        }

        return new Decision(response.getText(), null);
    }

    private Optional<String> retrieveRagContext(String input, String subFlow) {
        List<LlmService.RagVectorData> similarResults = llmService.queryVectorData(input, subFlow);
        return Optional.of(similarResults.stream()
            .map(data -> "Issue: " + data.getIssue() + ", Sub-flow: " + data.getSubFlow() + ", Solution: " + data.getSolution())
            .collect(Collectors.joining("\n")));
    }

    @Override
    public String act(String sessionId, Object decisionObj) {
        Decision decision = (Decision) decisionObj;
        respond(decision.text);
        return decision.text;
    }

    @Override
    public void respond(String message) {
        System.out.println("[VoiceAgent] " + message);
    }

    @Getter
    private static class Decision {
        private final String text;
        private final String toolResult;

        Decision(String text, String toolResult) {
            this.text = text;
            this.toolResult = toolResult;
        }
    }
}
