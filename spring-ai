        put("cant_make_calls", "Handle a situation where the user cannot make calls.");
        put("cant_receive_calls", "Handle a situation where the user cannot receive calls.");
        put("dropped_calls", "Handle a situation where the user experiences dropped calls.");
    }};

    public String getPrompt(String subFlow) {
        return Optional.ofNullable(mongoTemplate.findOne(
                Query.query(Criteria.where("subFlow").is(subFlow)), PromptEntity.class, "voice_prompts"))
            .map(PromptEntity::getPrompt)
            .orElseGet(() -> hardcodedPrompts.getOrDefault(subFlow, "Default prompt for unknown sub-flow."));
    }

    public boolean isSubFlowAvailable(String subFlow) {
        return mongoTemplate.exists(Query.query(Criteria.where("subFlow").is(subFlow)), PromptEntity.class, "voice_prompts")
            || hardcodedPrompts.containsKey(subFlow);
    }

    public boolean isFlowAvailable(String flowIdentifier) {
        return "voice".equalsIgnoreCase(flowIdentifier);
    }

    @RequiredArgsConstructor
    public static class PromptEntity {
        private final String subFlow;
        private final String prompt;

        public String getSubFlow() {
            return subFlow;
        }

        public String getPrompt() {
            return prompt;
        }
    }
}
