package com.example.dice;

import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import java.util.UUID;

@Service
@RequiredArgsConstructor
public class DaasService {
    private final LlmService llmService;
    private final ChatHistoryService chatHistoryService;
    private final KnowledgeService knowledgeService;
    private final LearningService learningService;
    private final SessionSummaryService sessionSummaryService;
    private final AgentFactory agentFactory;
    private final VoiceAgentPrompts voiceAgentPrompts;

    public ResponseEntity<String> engage(DiceSessionContext context) {
        if (!isValidEngageInput(context)) {
            return ResponseEntity.badRequest().body("BAN is required and flowIdentifier must be 'voice'.");
        }

        String diceSessionId = "dice_" + UUID.randomUUID().toString();
        context.setDiceSessionId(diceSessionId);
        OrchestratorAgent orchestrator = createOrchestrator();
        String response = orchestrator.startSession(context);
        return ResponseEntity.ok("Session started. diceSessionId: " + diceSessionId + "\n" + response);
    }

    public ResponseEntity<String> next(DiceSessionContext context) {
        if (!isValidNextInput(context)) {
            return ResponseEntity.badRequest().body("BAN, diceSessionId, and valid flowIdentifier are required.");
        }

        OrchestratorAgent orchestrator = createOrchestrator();
        String response = orchestrator.continueSession(context);
        return ResponseEntity.ok(response);
    }

    private boolean isValidEngageInput(DiceSessionContext context) {
        return context.getBan() != null && "voice".equalsIgnoreCase(context.getFlowIdentifier()) &&
               voiceAgentPrompts.isFlowAvailable(context.getFlowIdentifier());
    }

    private boolean isValidNextInput(DiceSessionContext context) {
        return context.getBan() != null && context.getDiceSessionId() != null &&
               "voice".equalsIgnoreCase(context.getFlowIdentifier()) &&
               voiceAgentPrompts.isFlowAvailable(context.getFlowIdentifier());
    }

    private OrchestratorAgent createOrchestrator() {
        return new OrchestratorAgent(llmService, chatHistoryService, knowledgeService, learningService, sessionSummaryService, agentFactory, voiceAgentPrompts);
    }
}
