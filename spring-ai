package com.example.dice;

import lombok.*;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

@Service
@RequiredArgsConstructor
public class LearningService {
    private final MongoTemplate mongoTemplate;

    @Getter
    @Setter
    @NoArgsConstructor
    @AllArgsConstructor
    public static class LearnedOutcome {
        private String issue;
        private String subFlow;
        private String solution;
        private int successCount;
    }

    public void recordSuccess(String issue, String subFlow, String solution) {
        Query query = Query.query(Criteria.where("issue").is(issue).and("subFlow").is(subFlow).and("solution").is(solution));
        LearnedOutcome outcome = mongoTemplate.findOne(query, LearnedOutcome.class, "learned_outcomes");
        if (outcome == null) {
            outcome = new LearnedOutcome(issue, subFlow, solution, 1);
        } else {
            outcome.successCount++;
        }
        mongoTemplate.save(outcome, "learned_outcomes");

        // Save to RAG vectors (assuming vectorization happens externally)
        mongoTemplate.save(new LlmService.RagVectorData(issue, subFlow, solution, new float[]{/* vectorized data */}), "rag_vectors");
    }

    public String getLearnedSolution(String issue, String subFlow) {
        Query query = Query.query(Criteria.where("issue").is(issue).and("subFlow").is(subFlow)).sort().on("successCount", -1);
        return Optional.ofNullable(mongoTemplate.findOne(query, LearnedOutcome.class, "learned_outcomes"))
            .map(LearnedOutcome::getSolution)
            .orElse(null);
    }
}
