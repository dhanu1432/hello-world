import org.springframework.stereotype.Component;

import java.util.Optional;

@Component
@RequiredArgsConstructor
public abstract class IssueAgent implements DaasAgent<DiceSessionContext> {
    protected final LlmService llmService;
    protected final ChatHistoryService chatHistoryService;
    protected final LearningService learningService;
    protected final Environment environment;

    protected abstract String getAgentKey();

    @Override
    public Object processInput(DiceSessionContext input) {
        return input.getUserInput();
    }

    @Override
    public boolean handleError(Exception error) {
        respond("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive(String sessionId) {
        return Optional.ofNullable(chatHistoryService.getAgentState(sessionId, getAgentKey()))
            .map(state -> !state.isCompleted())
            .orElse(false);
    }

    @Override
    public void learn(String sessionId, String issue, String subFlow, String solution) {
        learningService.recordSuccess(issue, subFlow, solution);
        ChatHistoryService.AgentState state = Optional.ofNullable(chatHistoryService.getAgentState(sessionId, issue))
            .map(s -> {
                s.setCompleted(true);
                return s;
            })
            .orElseGet(() -> new ChatHistoryService.AgentState(sessionId, issue, subFlow, 0, true));
        chatHistoryService.saveAgentState(state);
    }

    protected void saveToHistory(String sessionId, String message) {
        chatHistoryService.saveChatHistory(sessionId, message);
    }

    protected String getBan(String sessionId) {
        return Optional.ofNullable(chatHistoryService.getOrchestratorState(sessionId))
            .map(ChatHistoryService.OrchestratorState::getBan)
            .orElse(null);
    }
}
