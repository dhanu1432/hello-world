            List<Document> results = collection.aggregate(java.util.Arrays.asList(pipeline)).into(new java.util.ArrayList<>());
            System.out.println("Native Results: " + results.size());
            results.forEach(System.out::println);
        } catch (Exception e) {
            System.err.println("Native Search Failed: " + e.getMessage());
            e.printStackTrace();
        }
    }

    public static void main(String[] args) {
        String uri = "mongodb+srv://teamA_user:teamA_pass@xxxxx.mongodb.net/teamA_db?retryWrites=true&w=majority";
        float[] queryEmbedding = new float[1536]; // Replace with actual embedding
        testVectorSearch(uri, queryEmbedding);
    }
}
