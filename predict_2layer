### Corrected Prediction Code

To fix the issue, the prediction script’s `GRUClassifier` must match the training script’s architecture exactly. Below is the corrected code, aligned with the 2-layer GRU from the enhanced training script, along with additional robustness improvements.

```python
import torch
import torch.nn as nn
import numpy as np
import openai
import os
from dotenv import load_dotenv

# ------------------------------
# Load API Key
# ------------------------------
load_dotenv()
api_key = os.getenv("OPENAI_API_KEY")
if not api_key:
    raise ValueError("OPENAI_API_KEY not found in environment variables")
client = openai.OpenAI(api_key=api_key)

# ------------------------------
# GRU Classifier
# ------------------------------
class GRUClassifier(nn.Module):
    def __init__(self, input_dim, hidden_dim=64, num_layers=2, dropout=0.3):
        super().__init__()
        self.gru = nn.GRU(input_dim, hidden_dim, num_layers=num_layers, batch_first=True, dropout=dropout if num_layers > 1 else 0)
        self.dropout = nn.Dropout(dropout)
        self.fc = nn.Linear(hidden_dim, 2)
    
    def forward(self, x):
        x = x.unsqueeze(1)
        _, h = self.gru(x)
        h = h[-1]  # Take the last layer's hidden state
        h = self.dropout(h)
        logits = self.fc(h)
        return logits

# ------------------------------
# Embedding Function
# ------------------------------
def get_embedding(text, model="text-embedding-3-small"):
    try:
        response = client.embeddings.create(model=model, input=text)
        return np.array(response.data[0].embedding, dtype=np.float32)
    except Exception as e:
        raise RuntimeError(f"Failed to get embedding: {str(e)}")

# ------------------------------
# Prediction
# ------------------------------
def predict(model, embedding, device):
    if not isinstance(embedding, (list, np.ndarray)) or not len(embedding):
        raise ValueError("Embedding must be a non-empty list or numpy array")
    embedding = torch.tensor(embedding, dtype=torch.float32).unsqueeze(0).to(device)
    model.eval()
    with torch.no_grad():
        output = model(embedding)
        pred = torch.argmax(output, dim=1).item()
        return "yes" if pred == 1 else "no"

# ------------------------------
# Main
# ------------------------------
if __name__ == "__main__":
    # Configuration (adjust based on training setup)
    INPUT_DIM = 1536  # Default for text-embedding-3-small
    HIDDEN_DIM = 64
    NUM_LAYERS = 2
    DROPOUT = 0.3
    MODEL_PATH = "gru_classifier.pt"
    
    # Set device
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    # Initialize model
    try:
        model = GRUClassifier(INPUT_DIM, HIDDEN_DIM, NUM_LAYERS, DROPOUT).to(device)
        if not os.path.exists(MODEL_PATH):
            raise FileNotFoundError(f"Model file {MODEL_PATH} not found")
        model.load_state_dict(torch.load(MODEL_PATH, map_location=device))
    except Exception as e:
        raise RuntimeError(f"Failed to load model: {str(e)}")
    
    # Get user input and predict
    try:
        user_input = input("Enter user input: ")
        if not user_input.strip():
            raise ValueError("Input cannot be empty")
        embedding = get_embedding(user_input)
        if len(embedding) != INPUT_DIM:
            raise ValueError(f"Embedding dimension {len(embedding)} does not match expected {INPUT_DIM}")
        prediction = predict(model, embedding, device)
        print(f"Prediction: {prediction}")
    except Exception as e:
        print(f"Error: {str(e)}")
```

