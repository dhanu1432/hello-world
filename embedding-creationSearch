### Step 2: Configuration and Embedding Creation

We’ll create a service to generate embeddings and store them in the new collection.

#### `FlowConfig.java`

```java
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import org.springframework.ai.embedding.EmbeddingModel;
import org.springframework.ai.openai.OpenAiEmbeddingModel;
import org.springframework.ai.openai.api.OpenAiApi;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.mongodb.core.MongoTemplate;

@Configuration
public class FlowConfig {

    @Value("${spring.data.mongodb.uri}")
    private String mongoUri;

    @Value("${spring.data.mongodb.database}")
    private String mongoDatabase;

    @Value("${spring.ai.openai.api-key}")
    private String openAiApiKey;

    @Bean
    public MongoClient mongoClient() {
        MongoClient client = MongoClients.create(mongoUri);
        System.out.println("MongoClient Hosts: " + client.getClusterDescription().getClusterSettings().getHosts());
        return client;
    }

    @Bean
    public MongoTemplate mongoTemplate(MongoClient mongoClient) {
        return new MongoTemplate(mongoClient, mongoDatabase);
    }

    @Bean
    public EmbeddingModel embeddingModel() {
        OpenAiApi openAiApi = new OpenAiApi(openAiApiKey);
        return new OpenAiEmbeddingModel(openAiApi, "text-embedding-3-small", 1536);
    }

    @Bean
    public VectorCreationService vectorCreationService(MongoTemplate mongoTemplate, EmbeddingModel embeddingModel) {
        return new VectorCreationService(mongoTemplate, embeddingModel);
    }

    @Bean
    public VectorSearchService vectorSearchService(MongoClient mongoClient, EmbeddingModel embeddingModel) {
        return new VectorSearchService(mongoClient, embeddingModel);
    }
}
```

#### `VectorCreationService.java`

This service creates embeddings for sample text and stores them in `java_vector_team_a`.

```java
import org.springframework.ai.document.Document;
import org.springframework.ai.embedding.EmbeddingModel;
import org.springframework.data.mongodb.core.MongoTemplate;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class VectorCreationService {

    private final MongoTemplate mongoTemplate;
    private final EmbeddingModel embeddingModel;
    private final String collectionName = "java_vector_team_a";

    public VectorCreationService(MongoTemplate mongoTemplate, EmbeddingModel embeddingModel) {
        this.mongoTemplate = mongoTemplate;
        this.embeddingModel = embeddingModel;
    }

    public void createAndStoreEmbeddings() {
        // Sample texts
        List<String> sampleTexts = Arrays.asList(
            "The quick brown fox jumps over the lazy dog.",
            "A journey of a thousand miles begins with a single step.",
            "To be or not to be, that is the question.",
            "All that glitters is not gold.",
            "The early bird catches the worm."
        );

        // Drop existing collection to start fresh
        mongoTemplate.dropCollection(collectionName);

        // Create and store embeddings
        for (String text : sampleTexts) {
            float[] embedding = embeddingModel.embed(text);
            Map<String, Object> metadata = new HashMap<>();
            metadata.put("source", "sample_text");

            Document document = new Document(text, metadata);
            org.bson.Document bsonDoc = new org.bson.Document()
                    .append("text", text)
                    .append("embedding", embedding)
                    .append("metadata", metadata);

            mongoTemplate.insert(bsonDoc, collectionName);
            System.out.println("Inserted: " + text);
        }

        // Create vector index with dot product similarity
        createVectorIndex();
    }

    private void createVectorIndex() {
        org.bson.Document indexCommand = new org.bson.Document()
                .append("createSearchIndexes", collectionName)
                .append("indexes", Arrays.asList(
                        new org.bson.Document()
                                .append("name", "vector_index")
                                .append("definition", new org.bson.Document()
                                        .append("fields", Arrays.asList(
                                                new org.bson.Document()
                                                        .append("type", "vector")
                                                        .append("path", "embedding")
                                                        .append("numDimensions", 1536)
                                                        .append("similarity", "dotProduct")
                                        ))
                                )
                ));

        mongoTemplate.getDb().runCommand(indexCommand);
        System.out.println("Vector index created with dot product similarity.");
    }
}
```

- **Notes**:
  - Drops and recreates `java_vector_team_a` for a clean test.
  - Uses `text-embedding-3-small` to generate 1536-dimension embeddings.
  - Creates a vector index with `dotProduct` similarity.

