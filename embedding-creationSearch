### Step 3: Vector Search Service

Search the new collection with dot product similarity.

#### `VectorSearchService.java`

```java
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import org.springframework.ai.document.Document;
import org.springframework.ai.embedding.EmbeddingModel;
import org.bson.Document;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

public class VectorSearchService {

    private final MongoClient mongoClient;
    private final EmbeddingModel embeddingModel;
    private final String collectionName = "java_vector_team_a";

    public VectorSearchService(MongoClient mongoClient, EmbeddingModel embeddingModel) {
        this.mongoClient = mongoClient;
        this.embeddingModel = embeddingModel;
    }

    public List<Document> retrieve(String query) {
        System.out.println("Hosts Before Search: " + mongoClient.getClusterDescription().getClusterSettings().getHosts());

        MongoCollection<org.bson.Document> collection = mongoClient.getDatabase("teamA_db")
                .getCollection(collectionName);

        float[] queryEmbedding = embeddingModel.embed(query);

        Document vectorSearch = new Document("$vectorSearch", 
            new Document()
                .append("index", "vector_index")
                .append("path", "embedding")
                .append("queryVector", queryEmbedding)
                .append("numCandidates", 10)
                .append("limit", 5)
        );

        Document project = new Document("$project", 
            new Document()
                .append("_id", 0)
                .append("text", 1)
                .append("metadata", 1)
                .append("score", new Document("$meta", "vectorSearchScore"))
        );

        try {
            List<org.bson.Document> results = collection.aggregate(Arrays.asList(vectorSearch, project))
                    .into(new ArrayList<>());
            System.out.println("Search Successful: " + results.size());
            return results.stream()
                    .filter(result -> result.getDouble("score") >= 0.7) // Adjust threshold as needed
                    .map(result -> {
                        Map<String, Object> metadata = (Map<String, Object>) result.get("metadata");
                        if (metadata == null) {
                            metadata = new HashMap<>();
                        }
                        metadata.put("similarityScore", result.get("score"));
                        return new Document(result.getString("text"), metadata);
                    })
                    .collect(Collectors.toList());
        } catch (Exception e) {
            System.err.println("Search Failed: " + e.getMessage());
            e.printStackTrace();
            throw e;
        }
    }
}
```

