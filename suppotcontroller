package com.example.aiagent.controllers;

import com.example.aiagent.graph.SupportAgentGraph;
import com.example.aiagent.state.SupportAgentState;
import org.bsc.langgraph4j.GraphState;
import org.bsc.langgraph4j.StateGraph;
import org.springframework.ai.vectorstore.MongoDBVectorStore;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Map;
import java.util.UUID;

@RestController
@RequestMapping("/api/support")
public class SupportController {

    private final SupportAgentGraph supportAgentGraph;
    private final MongoDBVectorStore vectorStore;

    @Autowired
    public SupportController(SupportAgentGraph supportAgentGraph, MongoDBVectorStore vectorStore) {
        this.supportAgentGraph = supportAgentGraph;
        this.vectorStore = vectorStore;
    }

    @PostMapping("/chat")
    public String chat(@RequestBody String userInput) throws Exception {
        String memoryId = UUID.randomUUID().toString();
        StateGraph<SupportAgentState> graph = supportAgentGraph.buildGraph();
        SupportAgentState state = new SupportAgentState(Map.of(
            SupportAgentState.MESSAGES_KEY, userInput,
            "memoryId", memoryId
        ));

        // Retrieve context from knowledge base
        String context = vectorStore.similaritySearch(userInput).stream()
            .map(Document::getContent)
            .collect(Collectors.joining("\n"));
        state.put("context", context);

        GraphState<SupportAgentState> result = graph.compile().invoke(state);
        return result.getState().messages().get(result.getState().messages().size() - 1);
    }
}
