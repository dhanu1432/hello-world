### 6. Updated `PromptTemplateService` and `TemplatePromptBuilder`

Unchanged from previous versions:

#### `PromptTemplateService`
```java
package com.example.service;

import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

@Service
public class PromptTemplateService {

    private final MongoTemplate mongoTemplate;

    public PromptTemplateService(MongoTemplate mongoTemplate) {
        this.mongoTemplate = mongoTemplate;
    }

    public String getTemplateByName(String templateName) {
        Query query = new Query(Criteria.where("template_name").is(templateName));
        PromptTemplateDoc doc = mongoTemplate.findOne(query, PromptTemplateDoc.class, "prompt_templates");
        if (doc == null || doc.getTemplateText() == null) {
            throw new IllegalArgumentException("No template found for template_name: " + templateName);
        }
        return doc.getTemplateText();
    }

    public static class PromptTemplateDoc {
        private String templateName;
        private String templateText;

        public String getTemplateName() {
            return templateName;
        }

        public void setTemplateName(String templateName) {
            this.templateName = templateName;
        }

        public String getTemplateText() {
            return templateText;
        }

        public void setTemplateText(String templateText) {
            this.templateText = templateText;
        }
    }
}
```

#### `TemplatePromptBuilder`
```java
package com.example.service;

import org.springframework.ai.prompt.PromptTemplate;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.util.Map;

@Service
public class TemplatePromptBuilder implements PromptBuilder {

    private final PromptTemplateService templateService;
    private final String defaultTemplateName;

    public TemplatePromptBuilder(PromptTemplateService templateService,
                                 @Value("${prompt.templateName:default}") String defaultTemplateName) {
        this.templateService = templateService;
        this.defaultTemplateName = defaultTemplateName;
    }

    @Override
    public String buildPrompt(Map<String, Object> parameters) {
        String templateText = templateService.getTemplateByName(defaultTemplateName);
        PromptTemplate promptTemplate = new PromptTemplate(templateText);
        return promptTemplate.render(parameters);
    }

    public String buildPromptWithTemplate(String templateName, Map<String, Object> parameters) {
        String templateText = templateService.getTemplateByName(templateName);
        PromptTemplate promptTemplate = new PromptTemplate(templateText);
        return promptTemplate.render(parameters);
    }
}
```

