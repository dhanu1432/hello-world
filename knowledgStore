### 5. Updated `DynamicPromptService`

Now supports dynamic selection of both `VectorStore` and `KnowledgeStore`:

```java
package com.example.service;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.ai.vectorstore.VectorStore;
import org.springframework.stereotype.Service;

import java.util.HashMap;
import java.util.Map;

@Service
public class DynamicPromptService {

    private final VectorContextRetriever vectorContextRetriever;
    private final PromptTemplateService promptTemplateService;
    private final TemplatePromptBuilder promptBuilder;
    private final Map<String, VectorStore> vectorStores;
    private final Map<String, KnowledgeStore> knowledgeStores;
    private final VectorStore defaultVectorStore;
    private final KnowledgeStore defaultKnowledgeStore;

    @Autowired
    public DynamicPromptService(
            VectorContextRetriever vectorContextRetriever,
            PromptTemplateService promptTemplateService,
            TemplatePromptBuilder promptBuilder,
            Map<String, VectorStore> vectorStores,
            Map<String, KnowledgeStore> knowledgeStores,
            @Qualifier("defaultVectorStore") VectorStore defaultVectorStore,
            @Qualifier("defaultKnowledgeStore") KnowledgeStore defaultKnowledgeStore) {
        this.vectorContextRetriever = vectorContextRetriever;
        this.promptTemplateService = promptTemplateService;
        this.promptBuilder = promptBuilder;
        this.vectorStores = vectorStores;
        this.knowledgeStores = knowledgeStores;
        this.defaultVectorStore = defaultVectorStore;
        this.defaultKnowledgeStore = defaultKnowledgeStore;
    }

    public String buildPrompt(String input, String filterExpression, String templateName, String vectorStoreName, String knowledgeStoreName) {
        String context = null;

        // Try VectorStore if specified
        if (vectorStoreName != null) {
            VectorStore selectedVectorStore = vectorStores.getOrDefault(vectorStoreName, defaultVectorStore);
            context = vectorContextRetriever.retrieveContext(input, filterExpression, selectedVectorStore);
        }

        // Fallback to KnowledgeStore if VectorStore fails or not specified
        if (context == null && knowledgeStoreName != null) {
            KnowledgeStore selectedKnowledgeStore = knowledgeStores.getOrDefault(knowledgeStoreName, defaultKnowledgeStore);
            context = selectedKnowledgeStore.retrieveContext(input);
        }

        // If both fail and no specific store is requested, try defaults
        if (context == null && vectorStoreName == null && knowledgeStoreName == null) {
            context = vectorContextRetriever.retrieveContext(input, filterExpression, defaultVectorStore);
            if (context == null) {
                context = defaultKnowledgeStore.retrieveContext(input);
            }
        }

        Map<String, Object> params = new HashMap<>();
        params.put("question", input);
        params.put("context", context != null ? context : "No context available");

        if (templateName != null && !templateName.isEmpty()) {
            return promptBuilder.buildPromptWithTemplate(templateName, params);
        }
        return promptBuilder.buildPrompt(params);
    }
}
```

**Changes**:
- Removed direct dependency on `StaticContextRetriever`.
- Injected `Map<String, KnowledgeStore>` for all knowledge stores.
- Added `knowledgeStoreName` parameter to select a `KnowledgeStore`.
- Logic prioritizes `VectorStore` if specified, falls back to `KnowledgeStore`, and uses defaults if neither is provided.

