package com.example.dice;

import lombok.Getter;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Scope;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

import javax.annotation.PostConstruct;
import java.io.IOException;
import java.util.List;
import java.util.Map;

@Component
@Scope("prototype")
@RequiredArgsConstructor
public class CallAgent extends IssueAgent {
    private final KnowledgeService knowledgeService;
    private final SessionSummaryService sessionSummaryService;
    private final NetworkStatusTool networkStatusTool;
    private final Environment environment;

    private int currentStepIndex = 0;
    private String currentSubFlow;
    private final Map<String, AgentTool> tools = Map.of("network_status", networkStatusTool);

    @Value("${agent.call.mode:default}")
    private String agentMode;

    @PostConstruct
    public void init() {
        ChatHistoryService.AgentState state = chatHistoryService.getAgentState(sessionId, "call");
        if (state != null) {
            this.currentSubFlow = state.getSubFlow();
            this.currentStepIndex = state.getStepIndex();
            this.active = !state.isCompleted();
            updateState("stepIndex", String.valueOf(currentStepIndex));
        }
    }

    @Override
    protected AgentMode getAgentMode() {
        return agentMode.equalsIgnoreCase("default") ? null : AgentMode.valueOf(agentMode.toUpperCase());
    }

    @Override
    protected String getAgentKey() {
        return "call";
    }

    @Override
    public Object processInput(String input) {
        saveToHistory("User: " + input);
        return input;
    }

    @Override
    public Object decide(Object processedData) {
        String input = (String) processedData;
        List<String> chatHistory = chatHistoryService.getChatHistory(sessionId);

        if (currentSubFlow == null) {
            String prompt = "User says: '" + input + "'\n" +
                            "Classify into a sub-flow: cant_make_calls, cant_receive_calls, dropped_calls. " +
                            "If input is empty, ask the user to specify.";
            LlmService.LlmResponse subFlowResponse = llmService.generateResponse(prompt, chatHistory);
            if (subFlowResponse.getText().contains("specify")) {
                return new Decision(subFlowResponse.getText(), null);
            }
            currentSubFlow = subFlowResponse.getText().trim();
            saveToHistory("Agent: Identified sub-flow: " + currentSubFlow);
            chatHistoryService.saveAgentState(sessionId, "call", currentSubFlow, currentStepIndex, false);
        }

        AgentMode effectiveMode = getEffectiveMode(currentSubFlow);
        String prompt;

        switch (effectiveMode) {
            case DETERMINISTIC:
                List<String> steps = knowledgeService.getSteps("call");
                if (currentStepIndex >= steps.size()) {
                    prompt = "User says: '" + input + "'\nAll steps exhausted. Suggest contacting support.";
                } else {
                    String step = steps.get(currentStepIndex);
                    prompt = step + "\nUser response: '" + input + "'\nProvide a natural response.";
                    currentStepIndex++;
                    updateState("stepIndex", String.valueOf(currentStepIndex));
                    chatHistoryService.saveAgentState(sessionId, "call", currentSubFlow, currentStepIndex, false);
                }
                break;

            case AGENT_AS_A_DRIVER:
                String knowledge = knowledgeService.getKnowledge("call");
                String learnedSolution = learningService.getLearnedSolution("call", currentSubFlow);
                StringBuilder pastSummaries = new StringBuilder();
                List<SessionSummaryService.SessionSummary> summaries = sessionSummaryService.getSummariesByBan(ban);
                for (SessionSummaryService.SessionSummary summary : summaries) {
                    pastSummaries.append("BAN: ").append(summary.getBan())
                                 .append(", Summary: ").append(summary.getSummary())
                                 .append(", Sentiment: ").append(summary.getSentiment()).append("\n");
                }
                prompt = "User says: '" + input + "'\n" +
                         "Sub-flow: " + currentSubFlow + "\n" +
                         "Knowledge: " + knowledge + "\n" +
                         (learnedSolution != null ? "Previously successful solution: " + learnedSolution + "\n" : "") +
                         (pastSummaries.length() > 0 ? "Past summaries:\n" + pastSummaries.toString() : "") +
                         "Suggest the next troubleshooting step or question.";
                break;

            case LLM_AS_A_DRIVER:
                prompt = "User says: '" + input + "'\n" +
                         "Sub-flow: " + currentSubFlow + "\n" +
                         "Fetch context from the web about mobile call troubleshooting and decide the next step or response.";
                break;

            default:
                throw new IllegalStateException("Unknown mode: " + effectiveMode);
        }

        LlmService.LlmResponse response = llmService.generateResponse(prompt, chatHistory);
        saveToHistory("Agent: " + response.getText());

        if (input.toLowerCase().contains("fixed") || input.toLowerCase().contains("working now")) {
            learn("call", currentSubFlow, response.getText());
            return new Decision("Great, glad it’s resolved!", null);
        }

        if (response.getTool() != null && tools.containsKey(response.getTool())) {
            try {
                String toolResult = tools.get(response.getTool()).execute(response.getToolInput() != null ? response.getToolInput() : "");
                saveToHistory("Tool Result: " + toolResult);
                return new Decision(response.getText(), toolResult);
            } catch (IOException e) {
                return new Decision(response.getText() + "\nTool failed: " + e.getMessage(), null);
            }
        }

        return new Decision(response.getText(), null);
    }

    @Override
    public boolean act(Object decisionObj) {
        Decision decision = (Decision) decisionObj;
        communicate(decision.text);
        if (decision.toolResult != null) {
            communicate("Tool Result: " + decision.toolResult);
            if (decision.toolResult.contains("signal\": \"weak\"")) {
                communicate("Action: Your signal is weak. Move to an area with better coverage.");
            } else if (decision.toolResult.contains("status\": \"inactive\"")) {
                communicate("Action: Your account is inactive. Please check with your provider.");
            } else {
                communicate("Action: Network seems fine. Let’s try another step.");
            }
        }
        return true;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[CallAgent] " + message);
    }

    @Getter
    private static class Decision {
        private final String text;
        private final String toolResult;

        Decision(String text, String toolResult) {
            this.text = text;
            this.toolResult = toolResult;
        }
    }
}
