```java
package com.example.dice;

import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import javax.annotation.PostConstruct;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Component
@RequiredArgsConstructor
public class OrchestratorAgent implements Agent<DiceSessionContext> {
    private final LlmService llmService;
    private final ChatHistoryService chatHistoryService;
    private final KnowledgeService knowledgeService;
    private final LearningService learningService;
    private final SessionSummaryService sessionSummaryService;
    private final AgentFactory agentFactory;

    private final String diceSessionId;
    private String olSessionId;
    private String ban;
    private boolean active;
    private String currentAgentKey;
    private final Map<String, IssueAgent> agents = new HashMap<>();

    @PostConstruct
    public void init() {
        OrchestratorState state = chatHistoryService.getOrchestratorState(diceSessionId);
        if (state != null) {
            this.olSessionId = state.getOlSessionId();
            this.ban = state.getBan();
            this.currentAgentKey = state.getCurrentAgentKey();
            this.active = state.isActive();
        } else {
            this.active = true;
        }

        agents.put("call", agentFactory.createAgent("call", diceSessionId));
        agents.put("text", agentFactory.createAgent("text", diceSessionId));
        agents.put("browse", agentFactory.createAgent("browse", diceSessionId));
    }

    @Override
    public DiceSessionContext perceiveEnvironment() {
        return null;
    }

    @Override
    public Object processInput(DiceSessionContext context) {
        String input = context.getUserInput() != null ? context.getUserInput() : context.getFlowIdentifier();
        chatHistoryService.saveChatHistory(diceSessionId, "User: " + input);
        if (input.contains("quit")) return "exit";

        this.olSessionId = context.getOlSessionId();
        this.ban = context.getBan();
        saveState();

        List<String> chatHistory = chatHistoryService.getChatHistory(diceSessionId);
        String prompt = "Classify this user input into one or more issues (call, text, browse): '" + input + "'";
        LlmService.LlmResponse response = llmService.generateResponse(prompt, chatHistory);
        chatHistoryService.saveChatHistory(diceSessionId, "Agent: Classified as " + response.getText());
        return response.getText().split(",");
    }

    @Override
    public Object decide(Object processedData) {
        String[] issues = (String[]) processedData;
        StringBuilder response = new StringBuilder();

        for (String issue : issues) {
            issue = issue.trim();
            if (issue.equals("exit")) {
                active = false;
                saveState();
                generateAndSaveSummary();
                return "Goodbye";
            }
            if (agents.containsKey(issue)) {
                if (currentAgentKey != null && !currentAgentKey.equals(issue)) {
                    response.append("Switching to handle '").append(issue).append("' issue.\n");
                }
                currentAgentKey = issue;
                saveState();
                IssueAgent agent = agents.get(issue);
                Object agentDecision = agent.decide(context.getUserInput() != null ? context.getUserInput() : "");
                agent.act(agentDecision);
                response.append(((CallAgent.Decision) agentDecision).text).append("\n");
            } else {
                response.append("I don’t recognize '").append(issue).append("'. Try 'call', 'text', or 'browse'.\n");
            }
        }
        return response.toString();
    }

    @Override
    public boolean act(Object decision) {
        communicate((String) decision);
        return true;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[Orchestrator] " + message);
    }

    @Override
    public boolean handleError(Exception error) {
        communicate("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive() {
        return active;
    }

    @Override
    public void learn(String issue, String subFlow, String solution) {
    }

    public String startSession(DiceSessionContext context) {
        this.olSessionId = context.getOlSessionId();
        this.ban = context.getBan();
        currentAgentKey = context.getFlowIdentifier();
        saveState();
        if (!agents.containsKey(currentAgentKey)) {
            return "Invalid flowIdentifier: " + currentAgentKey + ". Use 'call', 'text', or 'browse'.";
        }
        IssueAgent agent = agents.get(currentAgentKey);
        Object decision = agent.decide("");
        agent.act(decision);
        return ((CallAgent.Decision) decision).text;
    }

    public String continueSession(DiceSessionContext context) {
        this.olSessionId = context.getOlSessionId();
        this.ban = context.getBan();
        if (currentAgentKey == null || !active) {
            return "Session not initialized or completed. Start a new session with /engage.";
        }
        Object processed = processInput(context);
        Object decision = decide(processed);
        act(decision);
        return (String) decision;
    }

    private void saveState() {
        chatHistoryService.saveOrchestratorState(new OrchestratorState(diceSessionId, olSessionId, ban, currentAgentKey, active));
    }

    private void generateAndSaveSummary() {
        List<String> chatHistory = chatHistoryService.getChatHistory(diceSessionId);
        String summaryJson = llmService.generateSessionSummary(chatHistory);
        Gson gson = new Gson();
        Map<String, String> summaryMap = gson.fromJson(summaryJson, Map.class);
        String summary = summaryMap.get("summary");
        String sentiment = summaryMap.get("sentiment");
        sessionSummaryService.saveSessionSummary(olSessionId, diceSessionId, ban, summary, sentiment);
    }

    public String getDiceSessionId() {
        return diceSessionId;
    }
}
