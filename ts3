```java
package com.example.dice;

import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.Map;

@Component
@RequiredArgsConstructor
public abstract class IssueAgent implements Agent<DiceSessionContext> {
    protected final LlmService llmService;
    protected final ChatHistoryService chatHistoryService;
    protected final LearningService learningService;
    protected final String sessionId;

    @Value("${agent.default.mode:LLM_AS_A_DRIVER}")
    protected AgentMode defaultMode;
    protected final Environment environment;

    protected boolean active = true;
    protected Map<String, String> state = new HashMap<>();

    protected abstract AgentMode getAgentMode();

    protected abstract String getAgentKey();

    protected AgentMode getEffectiveMode(String subFlow) {
        AgentMode agentMode = getAgentMode();
        if (agentMode != null && !agentMode.name().equalsIgnoreCase("default")) {
            return agentMode;
        }

        String subFlowModeProperty = subFlow != null ? "agent." + getAgentKey() + "." + subFlow + ".mode" : "agent." + getAgentKey() + ".mode";
        String modeValue = environment.getProperty(subFlowModeProperty, defaultMode.name());
        return AgentMode.valueOf(modeValue.toUpperCase());
    }

    @Override
    public DiceSessionContext perceiveEnvironment() {
        return null;
    }

    @Override
    public boolean handleError(Exception error) {
        communicate("Error: " + error.getMessage());
        return false;
    }

    @Override
    public boolean isActive() {
        return active;
    }

    @Override
    public void learn(String issue, String subFlow, String solution) {
        learningService.recordSuccess(issue, subFlow, solution);
        chatHistoryService.saveAgentState(sessionId, issue, subFlow, state.getOrDefault("stepIndex", "0"), true);
        active = false;
    }

    protected void updateState(String key, String value) {
        state.put(key, value);
    }

    protected String getState(String key) {
        return state.getOrDefault(key, "unknown");
    }

    protected void saveToHistory(String message) {
        chatHistoryService.saveChatHistory(sessionId, message);
    }
}
