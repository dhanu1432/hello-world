                         "Knowledge: " + knowledge + "\n" +
                         (learnedSolution != null ? "Previously successful solution: " + learnedSolution + "\n" : "") +
                         (pastSummaries.length() > 0 ? "Past summaries:\n" + pastSummaries.toString() : "") +
                         "Suggest the next troubleshooting step or question.";
                break;

            case LLM_AS_A_DRIVER:
                prompt = "User says: '" + input + "'\n" +
                         "Fetch context from the web about mobile browsing troubleshooting and decide the next step or response.";
                break;

            default:
                throw new IllegalStateException("Unknown mode: " + effectiveMode);
        }

        LlmService.LlmResponse response = llmService.generateResponse(prompt, chatHistory);
        saveToHistory("Agent: " + response.getText());

        if (input.toLowerCase().contains("fixed") || input.toLowerCase().contains("working now")) {
            learn("browse", null, response.getText());
            return response.getText();
        }

        return response.getText();
    }

    @Override
    public boolean act(Object decision) {
        communicate((String) decision);
        return true;
    }

    @Override
    public void communicate(String message) {
        System.out.println("[BrowseAgent] " + message);
    }
}
