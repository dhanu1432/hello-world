package com.example.dice;

import com.google.gson.Gson;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.RequiredArgsConstructor;
import lombok.Setter;
import okhttp3.*;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.util.List;

@Service
@RequiredArgsConstructor
public class LlmService {
    private final OkHttpClient client = new OkHttpClient();
    private final Gson gson = new Gson();

    @Value("${llm.api.endpoint}")
    private String apiEndpoint;
    @Value("${llm.api.key}")
    private String apiKey;

    @Getter
    @Setter
    @NoArgsConstructor
    public static class LlmResponse {
        private String text;
        private String tool;
        private String toolInput;

        public LlmResponse(String text, String tool, String toolInput) {
            this.text = text;
            this.tool = tool;
            this.toolInput = toolInput;
        }
    }

    public LlmResponse generateResponse(String prompt, List<String> chatHistory) {
        try {
            StringBuilder fullPrompt = new StringBuilder();
            fullPrompt.append("Chat History:\n");
            for (String message : chatHistory) {
                fullPrompt.append(message).append("\n");
            }
            fullPrompt.append("Current Prompt:\n").append(prompt);
            fullPrompt.append("\nRespond with JSON: {\"text\": \"response\", \"tool\": \"tool_name\", \"toolInput\": \"input\"} " +
                              "or leave tool/toolInput null if no tool is needed.");

            RequestBody body = RequestBody.create(fullPrompt.toString(), MediaType.parse("text/plain"));
            Request request = new Request.Builder()
                .url(apiEndpoint)
                .header("Authorization", "Bearer " + apiKey)
                .post(body)
                .build();

            try (Response response = client.newCall(request).execute()) {
                if (!response.isSuccessful()) throw new IOException("Unexpected code " + response);
                return gson.fromJson(response.body().string(), LlmResponse.class);
            }
        } catch (IOException e) {
            System.err.println("LLM API error: " + e.getMessage());
            return new LlmResponse("Sorry, I couldn’t process that.", null, null);
        }
    }

    public String generateSessionSummary(List<String> chatHistory) {
        StringBuilder prompt = new StringBuilder();
        prompt.append("Chat History:\n");
        for (String message : chatHistory) {
            prompt.append(message).append("\n");
        }
        prompt.append("Generate a summary of this session including:\n" +
                      "- Steps performed and their effectiveness (effective/ineffective).\n" +
                      "- Customer sentiment at the end (positive, negative, neutral).\n" +
                      "Return in JSON: {\"summary\": \"steps and effectiveness\", \"sentiment\": \"sentiment\"}");

        try {
            RequestBody body = RequestBody.create(prompt.toString(), MediaType.parse("text/plain"));
            Request request = new Request.Builder()
                .url(apiEndpoint)
                .header("Authorization", "Bearer " + apiKey)
                .post(body)
                .build();

            try (Response response = client.newCall(request).execute()) {
                if (!response.isSuccessful()) throw new IOException("Unexpected code " + response);
                return response.body().string();
            }
        } catch (IOException e) {
            System.err.println("LLM summary error: " + e.getMessage());
            return "{\"summary\": \"Error generating summary\", \"sentiment\": \"neutral\"}";
        }
    }
}
