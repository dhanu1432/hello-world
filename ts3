import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Service;

@Service
@RequiredArgsConstructor
public class LearningService {
    private final MongoTemplate mongoTemplate;

    @Getter
    @Setter
    @NoArgsConstructor
    @AllArgsConstructor
    public static class LearnedOutcome {
        private String issue;
        private String subFlow;
        private String solution;
        private int successCount;
    }

    public void recordSuccess(String issue, String subFlow, String solution) {
        Query query = new Query(Criteria.where("issue").is(issue).and("subFlow").is(subFlow).and("solution").is(solution));
        LearnedOutcome outcome = mongoTemplate.findOne(query, LearnedOutcome.class, "learned_outcomes");
        if (outcome == null) {
            outcome = new LearnedOutcome(issue, subFlow, solution, 1);
        } else {
            outcome.successCount++;
        }
        mongoTemplate.save(outcome, "learned_outcomes");
    }

    public String getLearnedSolution(String issue, String subFlow) {
        Query query = new Query(Criteria.where("issue").is(issue).and("subFlow").is(subFlow))
            .sort().on("successCount", -1);
        LearnedOutcome outcome = mongoTemplate.findOne(query, LearnedOutcome.class, "learned_outcomes");
        return outcome != null ? outcome.getSolution() : null;
    }
}
