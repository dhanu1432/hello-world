import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class EmbedController {
    @Autowired
    DocumentRetrievalService documentRetrievalService;

    @PostMapping("/train")
    public ResponseEntity<?> train(@RequestBody RawDocuments docInfo){
        documentRetrievalService.train(docInfo.getRawDocs(), docInfo.getDocIds());
        return new ResponseEntity<>("", HttpStatus.OK);
    }
}

package com.example.demo.docs;

import org.ejml.simple.SimpleMatrix;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.stream.Collectors;

@Service
public class DocumentRetrievalService {
    @Autowired
    private DocEmbeddingRepository embeddingRepo;
    private SimpleMatrix docMatrix;
    private List<String> docIds;
/*
Usage
- Training: Call train() with your document list when the app starts or on a schedule.
- Retrieval: Use retrieveSimilar() to get top-k document IDs for a query,
then fetch their content from MongoDB for your LLM.
*/
    public void train(List<String> rawDocs, List<String> docIds) {
        this.docIds = docIds;
        TfIdfBuilder tfidf = new TfIdfBuilder(rawDocs);
        double[][] matrix = tfidf.buildMatrix();
        LsaEmbedder lsa = new LsaEmbedder(matrix, 50); // Adjust k as needed
        this.docMatrix = lsa.getDocVectors();          // Save to MongoDB
        for (int i = 0; i < docMatrix.numCols(); i++) {
            double[] vector = new double[docMatrix.numRows()];
            for (int j = 0; j < vector.length; j++) {
                vector[j] = docMatrix.get(j, i);
            }
            embeddingRepo.save(new DocEmbedding(null, docIds.get(i), vector));
        }
    }

    public List<String> retrieveSimilar(String query, int topK) {
        TextPreprocessor preprocessor = new TextPreprocessor();
        List<String> queryWords = preprocessor.preprocess(query);         // Simplified: Project query into LSA space (could refine with term vectors)
        double[] queryVector = new double[docMatrix.numRows()];         // (Add logic to map query to vector space using trained model)
        List<Double> similarities = new ArrayList<>();
        for (int i = 0; i < docMatrix.numCols(); i++) {
            double[] docVector = new double[docMatrix.numRows()];
            for (int j = 0; j < docVector.length; j++) {
                docVector[j] = docMatrix.get(j, i);
            }
            similarities.add(cosineSimilarity(queryVector, docVector));
        }          // Sort and return top-k doc IDs
        return topKIndices(similarities, topK).stream().map(i -> docIds.get(i)).collect(Collectors.toList());
    }

    private double cosineSimilarity(double[] v1, double[] v2) {
        double dot = 0, mag1 = 0, mag2 = 0;
        for (int i = 0; i < v1.length; i++) {
            dot += v1[i] * v2[i];
            mag1 += v1[i] * v1[i];
            mag2 += v2[i] * v2[i];
        }
        return dot / (Math.sqrt(mag1) * Math.sqrt(mag2));
    }

    private List<Integer> topKIndices(List<Double> values, int k) {
        return values.stream().sorted(Comparator.reverseOrder()).limit(k).map(values::indexOf).collect(Collectors.toList());
    }
}

