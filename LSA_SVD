package com.example.demo.docs;

import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

public class TextPreprocessor {
    public List<String> preprocess(String text) {
        return Arrays.stream(text.toLowerCase().replaceAll("[^a-z0-9\\s]", "") // Remove punctuation
                .split("\\s+")).filter(word -> !word.isEmpty()).collect(Collectors.toList());
    }
}

package com.example.demo.docs;

import java.util.*;
import java.util.stream.Collectors;

public class TfIdfBuilder {
    private List<List<String>> docs;
    // Preprocessed documents
    private Set<String> vocabulary;

    public TfIdfBuilder(List<String> rawDocs) {
        TextPreprocessor preprocessor = new TextPreprocessor();
        this.docs = rawDocs.stream().map(preprocessor::preprocess).collect(Collectors.toList());
        this.vocabulary = new HashSet<>();
        docs.forEach(doc -> vocabulary.addAll(doc));
    }

    public double[][] buildMatrix() {
        int numDocs = docs.size();
        int numTerms = vocabulary.size();
        double[][] matrix = new double[numTerms][numDocs];
        List<String> vocabList = new ArrayList<>(vocabulary);
        for (int d = 0; d < numDocs; d++) {
            List<String> doc = docs.get(d);
            Map<String, Integer> termFreq = new HashMap<>();
            doc.forEach(word -> termFreq.merge(word, 1, Integer::sum));
            for (int t = 0; t < numTerms; t++) {
                String term = vocabList.get(t);
                double tf = (double) termFreq.getOrDefault(term, 0) / doc.size();
                double idf = Math.log((double) numDocs / (1 + docs.stream().filter(docWords -> docWords.contains(term)).count()));
                matrix[t][d] = tf * idf;
            }
        }
        return matrix;
    }
}



package com.example.demo.docs;

import org.ejml.simple.SimpleMatrix;
import org.ejml.simple.SimpleSVD;

public class LsaEmbedder {
    private SimpleMatrix docVectors;

    public LsaEmbedder(double[][] termDocMatrix, int k) {
        // k = reduced dimensions, e.g., 50-100
        SimpleMatrix matrix = new SimpleMatrix(termDocMatrix);
        SimpleSVD<SimpleMatrix> svd = matrix.svd();
        SimpleMatrix U = svd.getU();
        // Term vectors
        SimpleMatrix W = svd.getW();
        // Diagonal matrix of singular values
        SimpleMatrix V = svd.getV(); // Document vectors
        // Extract singular values from W and create a kxk diagonal matrix
        int minDim = Math.min(W.numRows(), W.numCols());
        double[] singularValues = new double[minDim];
        for (int i = 0; i < minDim; i++) {
            singularValues[i] = W.get(i, i);
            // Get diagonal elements
        }
        SimpleMatrix S = new SimpleMatrix(k, k);
        for (int i = 0; i < k && i < singularValues.length; i++) {
            S.set(i, i, singularValues[i]);
            // Set diagonal values
        }
        // Reduce to k dimensions
        SimpleMatrix U_k = U.extractMatrix(0, SimpleMatrix.END, 0, k);
        SimpleMatrix V_k = V.extractMatrix(0, SimpleMatrix.END, 0, k);
        this.docVectors = V_k.mult(S); // Document embeddings (V_k * S)
    }

    public SimpleMatrix getDocVectors() {
        return docVectors;
    }
}



